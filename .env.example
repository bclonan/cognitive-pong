# Cognitive Pong runs in mock mode by default.
# No API key is required for local use.

PORT=3000
APP_URL=http://localhost:3000

# Optional Vite hot-reload websocket port for local development.
# Defaults to PORT + 1000. Set DISABLE_HMR=true for scripted smoke runs.
# COGNITIVE_PONG_HMR_PORT=4000
# DISABLE_HMR=false

# Safe default provider.
COGNITIVE_PONG_DEFAULT_PROVIDER=mock
COGNITIVE_PONG_DEFAULT_MODEL=mock-local

# Optional local persistence. Defaults are JSON files:
# - data/matches.json
# - data/arena-loop-battles.json
# Set both to one .sqlite file for local SQLite persistence. Requires Node.js with node:sqlite support.
# COGNITIVE_PONG_MATCHES_STORE=./data/cognitive-pong.sqlite
# COGNITIVE_PONG_ARENA_STORE=./data/cognitive-pong.sqlite

# Optional live provider adapters.
# You can also select providers per agent inside the UI.

# OpenAI-compatible / ChatGPT-compatible endpoint.
# COGNITIVE_PONG_DEFAULT_PROVIDER=openai-compatible
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# Ollama local endpoint.
# Start Ollama with OLLAMA_ORIGINS="*" when calling it from the browser.
# COGNITIVE_PONG_DEFAULT_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434

# Google Gemini.
# COGNITIVE_PONG_DEFAULT_PROVIDER=gemini
# GEMINI_API_KEY=

# Anthropic-style Messages API.
# COGNITIVE_PONG_DEFAULT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# Hugging Face Inference endpoint.
# COGNITIVE_PONG_DEFAULT_PROVIDER=huggingface
# HUGGINGFACE_API_KEY=
# HUGGINGFACE_ENDPOINT_URL=

# Custom HTTP provider adapter.
# COGNITIVE_PONG_DEFAULT_PROVIDER=custom-http
# CUSTOM_PROVIDER_URL=http://localhost:8787/cognitive-pong
# CUSTOM_PROVIDER_API_KEY=

# Optional bounded Arena Loop research providers.
# COGNITIVE_PONG_SEARCH_PROVIDER=mock
# ARENA_SEARCH_PROVIDER=mock
# ARENA_SEARCH_TIMEOUT_MS=5000
# SEARXNG_SEARCH_URL=http://localhost:8080/search
# BRAVE_SEARCH_API_KEY=
# BRAVE_SEARCH_URL=https://api.search.brave.com/res/v1/web/search
# TAVILY_API_KEY=
# TAVILY_SEARCH_URL=https://api.tavily.com/search

# Optional external agent bridges. Defaults to none.
# HTTP, WebSocket, and MCP-style bridges call user-owned services.
# CLI and Codex CLI bridges are local command execution and require explicit opt-in.
COGNITIVE_PONG_DEFAULT_AGENT_BRIDGE=none
# COGNITIVE_PONG_AGENT_BRIDGE_URL=http://localhost:8787/cognitive-pong/turn
# COGNITIVE_PONG_AGENT_BRIDGE_API_KEY=
# COGNITIVE_PONG_AGENT_BRIDGE_TOOL=cognitive_pong_turn
# COGNITIVE_PONG_AGENT_BRIDGE_TIMEOUT_MS=15000

# Local command bridges only. Keep disabled unless you trust the command.
COGNITIVE_PONG_ENABLE_LOCAL_BRIDGES=false
# Profiles are server-side allowlists. The browser can select a profile id, but cannot provide command/args.
# COGNITIVE_PONG_CLI_PROFILES={"local_node":{"command":"node","args":["./local-agent.js"],"cwd":"C:/path/to/workspace","timeoutMs":15000}}
# COGNITIVE_PONG_AGENT_BRIDGE_COMMAND=node
# COGNITIVE_PONG_AGENT_BRIDGE_ARGS=["./local-agent.js"]
# COGNITIVE_PONG_AGENT_BRIDGE_CWD=C:/path/to/workspace
# COGNITIVE_PONG_ENABLE_DANGER_FULL_ACCESS=false

# Codex CLI bridge preset. Requires COGNITIVE_PONG_ENABLE_LOCAL_BRIDGES=true.
# CODEX_CLI_COMMAND=codex
# CODEX_CLI_ARGS=["exec", "{prompt}"]
# CODEX_CLI_CWD=C:/path/to/workspace
